    {
      "name": "04 - POST - Incluir aluno válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Maria Silva\",\n  \"email\": \"maria@empresa.com\",\n  \"senha\": \"Senha@123\",\n  \"dataNascimento\": \"1995-05-20\",\n  \"media\": 9.5,\n  \"cpf\": \"123.456.789-09\",\n  \"telefone\": \"(47) 99999-9999\",\n  \"cep\": \"89120-000\",\n  \"idade\": 31,\n  \"altura\": 1.65,\n  \"peso\": 65.5,\n  \"quantidadeDependentes\": 2,\n  \"dataMatricula\": \"2026-09-14\",\n  \"dataConclusao\": \"2028-12-20\",\n  \"site\": \"https://www.exemplo.com\",\n  \"observacao\": \"Aluno cadastrado para testes.\",\n  \"ativo\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/alunos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test(\"Response has generated ID\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.expect(json.id).to.be.a(\"number\");",
              "});",
              "",
              "pm.test(\"Response contains expected fields\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.expect(json).to.have.property(\"nome\");",
              "    pm.expect(json).to.have.property(\"email\");",
              "    pm.expect(json).to.have.property(\"dataNascimento\");",
              "    pm.expect(json).to.have.property(\"media\");",
              "});",
              "",
              "pm.test(\"Password is not exposed\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.not.have.property(\"senha\");",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.id) {",
              "    pm.collectionVariables.set(\"alunoId\", json.id);",
              "}"
            ]
          }
        }
      ]
    },
