  "item": [
    {
      "name": "01 - GET - Listar todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/alunos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Response contains students\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET - Buscar aluno por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/alunos/{{alunoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "alunos",
            "{{alunoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test(\"Response contains expected fields\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.expect(json).to.have.property(\"nome\");",
              "    pm.expect(json).to.have.property(\"email\");",
              "    pm.expect(json).to.have.property(\"dataNascimento\");",
              "    pm.expect(json).to.have.property(\"media\");",
              "});",
              "",
              "pm.test(\"Password is not exposed\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.not.have.property(\"senha\");",
              "});"
            ]
          }
        }
      ]
    },
